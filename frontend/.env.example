# Vite reads env files from this directory (the frontend project root), not from
# the repo root.
#
# Note: config.js in frontend/public/ is the normal way to set the API host. It
# is read at page load, so changing the backend does not require a rebuild.
# VITE_API_BASE below takes precedence over config.js when it is present.

# Origin of the deployed API, no trailing slash, no /api suffix.
# Example: https://skimreel-api.fly.dev
# Leave unset to fall back to config.js, then to same-origin (npm run dev).
VITE_API_BASE=