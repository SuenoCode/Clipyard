# Vite reads env files from this directory (the frontend project root), not from
# the repo root. Copy to `.env.local` for local dev, or set the variable in the
# Vercel project settings for production.

# Origin of the deployed API, no trailing slash. Leave unset to keep requests
# same-origin, which is what `npm run dev` expects via the Vite proxy.
# Example: https://skimreel-api.fly.dev
VITE_API_BASE=